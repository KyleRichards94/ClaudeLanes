{
  "name": "@agent-lanes/desktop",
  "productName": "Agent Lanes",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Lanes desktop app: Electron main process + React Native (react-native-web) renderer.",
  "author": "Companion Systems",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint src e2e scripts",
    "e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --win",
    "e2e:packaged": "pnpm run package && playwright test -c playwright.packaged.config.ts",
    "icon": "node scripts/app-icon.mts"
  },
  "dependencies": {
    "@agent-lanes/ado-client": "workspace:*",
    "@agent-lanes/contracts": "workspace:*",
    "@agent-lanes/tokens": "workspace:*",
    "@agent-lanes/ui": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "electron-store": "^11.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "~5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "react-native": "^0.87.1",
    "vite": "~7.3.7"
  }
}
